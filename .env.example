# ============================================
# CLI-to-API Proxy Configuration
# ============================================
# Copy this file to .env and fill in your values

# === Proxy Settings ===
PROXY_PORT=8082
PROXY_HOST=0.0.0.0
PROXY_API_KEY=sk-cli-proxy-change-me
REQUIRE_AUTH=true
TIMEOUT_MS=300000

# === CLI Providers ===
DEFAULT_PROVIDER=claude
CLAUDE_CLI_PATH=claude
KIRO_CLI_PATH=kiro-cli

# === MCP Server Tokens ===
# Get from n8n: Settings → MCP Servers → Connect a client → API key
N8N_MCP_TOKEN=

# Get from GitHub: Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# Get from Slack: api.slack.com → Your Apps → OAuth & Permissions
SLACK_BOT_TOKEN=

# Get from Brave: brave.com/search/api
BRAVE_API_KEY=

# PostgreSQL connection string
POSTGRES_URL=postgresql://user:pass@localhost:5432/db

# === Custom MCP Servers ===
# Add your own MCP server tokens here
# CUSTOM_MCP_TOKEN=
