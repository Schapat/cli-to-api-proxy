{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CLI-to-API Proxy Configuration",
  "type": "object",
  "properties": {
    "proxy": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "default": 8082 },
        "host": { "type": "string", "default": "0.0.0.0" },
        "apiKey": { "type": "string", "description": "API key for proxy authentication" },
        "requireAuth": { "type": "boolean", "default": true },
        "timeoutMs": { "type": "integer", "default": 300000 }
      }
    },
    "providers": {
      "type": "object",
      "properties": {
        "default": { "type": "string", "enum": ["claude", "kiro"] },
        "claude": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "cliPath": { "type": "string", "default": "claude" },
            "description": { "type": "string" }
          }
        },
        "kiro": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "cliPath": { "type": "string", "default": "kiro-cli" },
            "description": { "type": "string" }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "transport"],
            "properties": {
              "name": { "type": "string", "description": "Unique identifier for this MCP server" },
              "description": { "type": "string" },
              "enabled": { "type": "boolean", "default": true },
              "transport": { 
                "type": "string", 
                "enum": ["stdio", "http-sse"],
                "description": "stdio for local process, http-sse for remote HTTP servers"
              },
              "url": { 
                "type": "string", 
                "description": "URL for http-sse transport" 
              },
              "command": { 
                "type": "string", 
                "description": "Command for stdio transport" 
              },
              "args": { 
                "type": "array", 
                "items": { "type": "string" },
                "description": "Arguments for stdio command"
              },
              "env": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "Environment variables for stdio process"
              },
              "auth": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["bearer", "api-key", "env", "none"] },
                  "token": { "type": "string", "description": "Token value or ${ENV_VAR} reference" },
                  "header": { "type": "string", "description": "Custom header name for api-key type" },
                  "variable": { "type": "string", "description": "Env var name for env type" }
                }
              },
              "headers": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "Additional HTTP headers"
              }
            }
          }
        }
      }
    },
    "toolFilters": {
      "type": "object",
      "properties": {
        "allowList": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Only allow these tools (empty = allow all)"
        },
        "denyList": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Block these tools"
        },
        "prefixWithServer": { 
          "type": "boolean", 
          "default": true,
          "description": "Prefix tool names with server name (e.g., n8n.search_workflows)"
        }
      }
    }
  }
}
