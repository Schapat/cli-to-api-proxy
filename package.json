{
  "name": "claude-cli-proxy",
  "version": "1.0.0",
  "description": "Proxy server that exposes Claude CLI as an Anthropic-compatible API endpoint",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "cli",
    "proxy",
    "anthropic",
    "api",
    "n8n"
  ],
  "author": "Patrick Scharnow",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
