{
  "name": "cli-to-api-proxy",
  "version": "2.0.0",
  "description": "Use Claude CLI or Kiro CLI as an OpenAI-compatible API",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "kiro",
    "cli",
    "proxy",
    "anthropic",
    "openai",
    "api"
  ],
  "author": "Patrick Scharnow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Schapat/cli-to-api-proxy.git"
  },
  "dependencies": {
    "express": "^4.21.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
